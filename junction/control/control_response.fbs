namespace junction.ctl_schema;

table SuccessResponse {}

table ErrorResponse {
    message: string;
}

table GetStatsResponse {
    // TODO(control): figure out response format
}

table InvokeResponse {
    message: string;
}

table RunResponse {
    pid: int;
}

table PSResponse {
    pids: [int];
}

table TracePoint {
    timestamp_us: uint64;
    accessed_location: uint64;
}

table TraceReport {
    accessed_us: [TracePoint];
}

union InnerResponse {
    error: ErrorResponse,
    genericSuccess: SuccessResponse,
    getStats: GetStatsResponse,
    traceReport: TraceReport,
    invokeResponse: InvokeResponse,
    runResponse: RunResponse,
    psResponse: PSResponse,
}

table Response {
    inner: InnerResponse;
}

root_type Response;
