namespace junction.ctl_schema;

table RunRequest {
    bin: string;
    argv: [string];
    envp: [string];
    is_init: bool;
    cwd: string;
    fsroot: string;
}

table SnapshotRequest {
    pid: uint64;
    snapshot_path: string;
    elf_path: string;
}

table RestoreRequest {
    snapshot_path: string;
    elf_path: string;
    name: string;
    argument: string;
}

table PSRequest {}

table StartTraceRequest {
    pid: uint64;
}

table StopTraceRequest {
    pid: uint64;
}

table SignalRequest {
    pid: uint64;
    signo: uint64;
}

table MigrateRequest {
    pid: uint64;
    dest_ip: uint32;
    dest_port: uint16;
}

table GetStatsRequest {
    // # TODO(control): figure out how to ask for stats
}

union InnerRequest {
    run: RunRequest,
    snapshot: SnapshotRequest,
    ps: PSRequest,
    restore: RestoreRequest,
    startTrace: StartTraceRequest,
    stopTrace: StopTraceRequest,
    signal: SignalRequest,
    getStats: GetStatsRequest,
    migrate: MigrateRequest
}

table Request {
    inner: InnerRequest;
}

root_type Request;
